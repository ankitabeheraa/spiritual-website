{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bloomwithin.world"
        }
      ],
      "destination": "https://www.bloomwithin.world/$1",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/contact",
      "permanent": true
    }
  ]
}
